<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textLab2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="1"
        android:gravity="center"
        android:textColor="@color/white"
        android:background="@color/black"
        android:textSize="20sp"
        android:text="Lab1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/textResponsive"/>
    <TextView
        android:id="@+id/textResponsive"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="1"
        android:gravity="center"
        android:textSize="20sp"
        android:text="Responsive Layout 1"
        app:layout_constraintTop_toBottomOf="@+id/textLab2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/layoutFirst" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutFirst"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="1"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/textResponsive"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/textApp">
        <TextView
            android:id="@+id/textThis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintHorizontal_weight="1"
            android:background="@color/red"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:gravity="center"
            android:text="This"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textIs"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView
            android:id="@+id/textIs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintHorizontal_weight="1"
            android:background="@color/blue"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:gravity="center"
            android:text="is"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/textThis"
            app:layout_constraintEnd_toStartOf="@id/textMy"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView
            android:id="@+id/textMy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintHorizontal_weight="1"
            android:background="@color/purple"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:gravity="center"
            android:text="my"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/textIs"
            app:layout_constraintEnd_toStartOf="@id/textFirst"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView
            android:id="@+id/textFirst"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintHorizontal_weight="1"
            android:background="@color/yellow"
            android:textSize="20sp"
            android:gravity="center"
            android:text="first"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/textMy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/textApp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="2"
        android:textColor="@color/white"
        android:background="@color/black"
        android:textSize="20sp"
        android:gravity="center"
        android:text="Android Application"
        app:layout_constraintTop_toBottomOf="@id/layoutFirst"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutSecond"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="1"
        android:id="@+id/layoutSecond"
        app:layout_constraintTop_toBottomOf="@id/textApp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <Button
            android:id="@+id/buttonChange"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="18dp"
            android:textSize="20sp"
            app:layout_constraintHorizontal_weight="1"
            android:text="Change"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonCancel"
            app:layout_constraintBottom_toBottomOf="parent">
        </Button>

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="18dp"
            android:textSize="20sp"
            app:layout_constraintHorizontal_weight="1"
            android:text="Cancel"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/buttonChange"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
        </Button>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>